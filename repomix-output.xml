│   │   └── LoginScreen.kt        # Compose UI
│   ├── home/
│   │   ├── HomeContract.kt
│   │   ├── HomeReducer.kt
│   │   ├── HomeViewModel.kt
│   │   └── HomeScreen.kt
│   └── settings/
│       ├── SettingsContract.kt
│       ├── SettingsReducer.kt
│       ├── SettingsViewModel.kt   # DreStoreViewModel
│       └── SettingsScreen.kt
```
