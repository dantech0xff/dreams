// Photo/illustration placeholder
Box(
    modifier = Modifier
        .size(width.dp, height.dp)
        .background(
            {Prefix}Theme.colors.surfaceVariant,
            {Prefix}Theme.shapes.medium,
        )
        .clip({Prefix}Theme.shapes.medium),
    contentAlignment = Alignment.Center,
