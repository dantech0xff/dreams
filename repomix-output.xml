            assertFalse(awaitItem().aboutOpen)
            vm.setAboutOpen(true)
            assertTrue(awaitItem().aboutOpen)
            vm.setAboutOpen(false)
            assertFalse(awaitItem().aboutOpen)
        }
    }
}
